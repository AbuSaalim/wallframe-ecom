{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  // Environment variables should be set via the Vercel Dashboard or CLI.
  // Remove this "env" mapping if you prefer to manage variables in the
  // Vercel Project Settings (recommended). If you use Vercel Secrets,
  // create them and reference with "@NAME" here.
  "functions": {
    "app/api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
